# Copier ce fichier en ".env" puis remplir. Le vrai .env est ignoré par Git.

# --- NASA FIRMS ---
FIRMS_MAP_KEY=votre_cle_ici

# --- Zone d'étude (west,south,east,north) ---
STUDY_BBOX=6.0,34.5,11.6,37.5
GRID_STEP_DEG=0.25

# --- Kafka (local = Redpanda via docker-compose) ---
KAFKA_BOOTSTRAP=localhost:19092
TOPIC_FIRES=fires_raw
TOPIC_WEATHER=weather_raw

# --- Stockage (local = MinIO ; sur AWS = vrai S3, laisser S3_ENDPOINT vide) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_RAW=firesense-raw
S3_BUCKET_CLEAN=firesense-clean
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# Sur le Learner Lab : AWS_SESSION_TOKEN change à chaque démarrage, ne jamais le commiter.
